# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth
SESSION_SECRET=change-this-session-secret

# Formmail admin whitelist (comma-separated)
FORMMAIL_ADMIN_EMAILS=admin@example.com
# Resend
RESEND_API_KEY=re_xxx
FORMMAIL_FROM_EMAIL=onboarding@resend.dev
## SMS 업무폰 연결 테스트
# 관리자 페이지 접근 가능 이메일(콤마 구분). 미설정 시 ADMIN_EMAILS를 사용합니다.
SMS_ADMIN_EMAILS=admin@example.com
# Android 앱 빌드 시에도 동일하게 지정하는 충분히 긴 임의 문자열입니다.
SMS_DEVICE_API_KEY=replace-with-a-long-random-secret
# 선택 사항: 기본값은 server/private-apk/nana-sms-sender.apk 입니다.
SMS_APK_PATH=/secure/deploy/nana-sms-sender.apk
