# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth
SESSION_SECRET=change-this-session-secret
# 기존 관리자 OWNER 초대 이메일(콤마 구분)
ADMIN_OWNER_EMAILS=admin@example.com

# Formmail admin whitelist (comma-separated)
FORMMAIL_ADMIN_EMAILS=admin@example.com
# Resend
RESEND_API_KEY=re_xxx
FORMMAIL_FROM_EMAIL=onboarding@resend.dev
## SMS 업무폰 연결 테스트
# Android 앱 빌드 시에도 동일하게 지정하는 충분히 긴 임의 문자열입니다.
SMS_DEVICE_API_KEY=replace-with-a-long-random-secret
# 비공개 GitHub 저장소의 SMS Release asset 조회용 fine-grained token (Contents: read)
SMS_GITHUB_TOKEN=github_pat_xxx
